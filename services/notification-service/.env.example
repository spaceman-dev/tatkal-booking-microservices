# notification-service config. copy to .env (scripts/stack.py setup does it for you)
SERVICE_NAME=notification-service
HOST=0.0.0.0
PORT=8004
DATABASE_URL=postgresql+psycopg://notification_svc:notification_dev_pw@localhost:5444/notification_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO

# fake SMS / e-mail provider
PROVIDER_FAILURE_RATE=0.0
PROVIDER_LATENCY_MS=30

# claim lease, and how long a duplicate waits for the delivery already sending the event
CLAIM_LEASE_SECONDS=30
DUPLICATE_WAIT_SECONDS=2.0

# dev only: enables PUT /api/v1/admin/provider to change the failure rate at runtime
ADMIN_API_ENABLED=true
