# payment-service configuration. Copy to .env (the setup script does this).
SERVICE_NAME=payment-service
HOST=0.0.0.0
PORT=8003
DATABASE_URL=postgresql+psycopg://payment_svc:payment_dev_pw@localhost:5443/payment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO

# External bank gateway (our mock) - timeout per attempt, retries with exponential backoff + full jitter
GATEWAY_URL=http://localhost:8099
GATEWAY_TIMEOUT_SECONDS=2.0
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_BACKOFF_BASE_SECONDS=0.2
GATEWAY_BACKOFF_CAP_SECONDS=2.0

# Idempotency-Key handling
IDEMPOTENCY_LEASE_SECONDS=60
IDEMPOTENCY_WAIT_SECONDS=15
