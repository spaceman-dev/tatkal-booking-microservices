flowchart LR
    client(["host<br/>curl, tests, scripts"])

    subgraph tatkal["docker compose project tatkal: 9 containers (services from images tatkal/&lt;name&gt;:1.0)"]
        direction LR
        subgraph bnet["network booking-data (internal)"]
            direction TB
            booking["<b>booking-service</b><br/>:8001"]
            bdb[("booking-db<br/>postgres 16")]
        end
        subgraph inet["network inventory-data (internal)"]
            direction TB
            inventory["<b>inventory-service</b><br/>:8002"]
            idb[("inventory-db<br/>postgres 16")]
        end
        subgraph pnet["network payment-data (internal)"]
            direction TB
            payment["<b>payment-service</b><br/>:8003"]
            pdb[("payment-db<br/>postgres 16")]
        end
        subgraph nnet["network notification-data (internal)"]
            direction TB
            notification["<b>notification-service</b><br/>:8004"]
            ndb[("notification-db<br/>postgres 16")]
        end
        bank["<b>mock-bank-gateway</b><br/>:8099"]
    end

    vols[("named volumes<br/>one per database")]
    envfile[/".env<br/>4 passwords<br/>not in git or images"/]

    client -- "published ports 8001-8004, 8099<br/>(databases not published)" --> booking
    booking -- "HTTP, network services<br/>http://inventory-service:8002" --> inventory
    booking -- "HTTP, network services<br/>http://payment-service:8003" --> payment
    booking -. "HTTP, async outbox<br/>http://notification-service:8004" .-> notification
    payment -- "HTTP, network bank<br/>http://mock-bank-gateway:8099" --> bank
    booking -- "SQL booking-db:5432" --- bdb
    inventory -- "SQL inventory-db:5432" --- idb
    payment -- "SQL payment-db:5432" --- pdb
    notification -- "SQL notification-db:5432" --- ndb
    bdb -.- vols
    idb -.- vols
    pdb -.- vols
    ndb -.- vols
    envfile -. "docker compose up puts them<br/>into the containers' environment" .-> tatkal
