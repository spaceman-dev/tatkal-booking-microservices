# mock-bank-gateway settings. Copy to .env (scripts/stack.py setup does that for you).
SERVICE_NAME=mock-bank-gateway
HOST=0.0.0.0
PORT=8099
LOG_LEVEL=INFO

# normal | slow | down | flaky, can be switched at runtime with PUT /gateway/v1/admin/mode
GATEWAY_MODE=normal
GATEWAY_LATENCY_MS=80
GATEWAY_SLOW_LATENCY_MS=4000
GATEWAY_FAILURE_RATE=0.5
