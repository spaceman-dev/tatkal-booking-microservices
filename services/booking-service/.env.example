# booking-service configuration. Copy to .env (the setup script does this).
SERVICE_NAME=booking-service
HOST=0.0.0.0
PORT=8001
DATABASE_URL=postgresql+psycopg://booking_svc:booking_dev_pw@localhost:5441/booking_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
LOG_LEVEL=INFO

# Other services (HTTP only - booking-service has no access to their databases)
INVENTORY_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
INVENTORY_TIMEOUT_SECONDS=3
PAYMENT_TIMEOUT_SECONDS=10
NOTIFICATION_TIMEOUT_SECONDS=3
DOWNSTREAM_RETRIES=1

# Idempotency-Key on POST /bookings (lease must be longer than the slowest saga)
IDEMPOTENCY_LEASE_SECONDS=60
IDEMPOTENCY_WAIT_SECONDS=20
IDEMPOTENCY_TTL_HOURS=24

# Background jobs: outbox dispatcher and saga recovery
BACKGROUND_JOBS_ENABLED=true
OUTBOX_POLL_SECONDS=2
RECOVERY_INTERVAL_SECONDS=10
COMPENSATION_RETRY_SECONDS=20
SAGA_STUCK_AFTER_SECONDS=60
