# Copy to .env (git ignores it) and change these before the first `docker compose up`.
# Letters, digits and '-' only: the passwords end up inside database URLs.
#
# A database keeps the password it was created with (it lives in the data volume). If you
# change one here later, either reset the data with `docker compose down -v` or change the
# password inside the database too (see the README, "Troubleshooting").
BOOKING_DB_PASSWORD=change-me-booking
INVENTORY_DB_PASSWORD=change-me-inventory
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification
