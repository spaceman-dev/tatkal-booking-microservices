# inventory-service config. Copy to .env (scripts/stack.py setup does it for you)
SERVICE_NAME=inventory-service
HOST=0.0.0.0
PORT=8002
DATABASE_URL=postgresql+psycopg://inventory_svc:inventory_dev_pw@localhost:5442/inventory_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO

SEED_DEMO_DATA=true
SEED_DAYS=7

# dev only: turns on /api/v1/admin/* (fault injection, hold strategy switch)
ADMIN_API_ENABLED=true

# atomic = the real one, naive = check-then-update (race demo only)
HOLD_STRATEGY=atomic
NAIVE_THINK_TIME_MS=150

# holds still HELD after HOLD_TTL_SECONDS get released, checked every HOLD_SWEEP_INTERVAL_SECONDS
HOLD_EXPIRY_ENABLED=true
HOLD_TTL_SECONDS=600
HOLD_SWEEP_INTERVAL_SECONDS=30
