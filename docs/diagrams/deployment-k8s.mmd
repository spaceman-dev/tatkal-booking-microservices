%%{init: {"themeVariables": {"fontSize": "17px"}, "flowchart": {"nodeSpacing": 18, "rankSpacing": 44, "diagramPadding": 4, "wrappingWidth": 280}}}%%
flowchart LR
    subgraph ns["Minikube, namespace tatkal"]
        direction LR
        cfg[/"ConfigMap per service<br/>Secret db-passwords (from .env)"/]
        subgraph b["booking"]
            direction LR
            bdep["<b>booking-service</b><br/>Service (ClusterIP :8001)<br/>Deployment, 2 replicas<br/>probes, preStop 5 s"] --- bdb[("StatefulSet booking-db<br/>headless Service<br/>PVC 1Gi")]
        end
        subgraph i["inventory"]
            direction LR
            inv["<b>inventory-service</b><br/>Service + Deployment<br/>1 replica"] --- idb[("StatefulSet<br/>inventory-db, PVC")]
        end
        subgraph n["notification"]
            direction LR
            noti["<b>notification-service</b><br/>Service + Deployment<br/>1 replica"] --- ndb[("StatefulSet<br/>notification-db, PVC")]
        end
        subgraph p["payment"]
            direction LR
            pay["<b>payment-service</b><br/>Service + Deployment<br/>1 replica"] --- pdb[("StatefulSet<br/>payment-db, PVC")]
        end
        subgraph bk["bank"]
            bank["<b>mock-bank-gateway</b><br/>Service + Deployment<br/>1 replica"]
        end
    end
    b -- "HTTP" --> i
    b -. "outbox" .-> n
    b -- "HTTP" --> p
    p -- "HTTP" --> bk
