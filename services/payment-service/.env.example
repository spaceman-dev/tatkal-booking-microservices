# payment-service settings. Copy to .env (scripts/stack.py setup does that for you).
SERVICE_NAME=payment-service
HOST=0.0.0.0
PORT=8003
DATABASE_URL=postgresql+psycopg://payment_svc:change-me-payment@localhost:5443/payment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO

# bank gateway (our mock). Timeout is per attempt, retries use exponential backoff with full jitter
GATEWAY_URL=http://localhost:8099
GATEWAY_TIMEOUT_SECONDS=2.0
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_BACKOFF_BASE_SECONDS=0.2
GATEWAY_BACKOFF_CAP_SECONDS=2.0

# Idempotency-Key handling
IDEMPOTENCY_LEASE_SECONDS=60
IDEMPOTENCY_WAIT_SECONDS=15
