# inventory-service configuration. Copy to .env (the setup script does this).
SERVICE_NAME=inventory-service
HOST=0.0.0.0
PORT=8002
DATABASE_URL=postgresql+psycopg://inventory_svc:inventory_dev_pw@localhost:5442/inventory_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO

SEED_DEMO_DATA=true
SEED_DAYS=7

# Dev only: exposes /api/v1/admin/* (fault injection, hold strategy switch)
ADMIN_API_ENABLED=true

# atomic = real implementation; naive = check-then-update, kept only for the Challenge 1 demo
HOLD_STRATEGY=atomic
NAIVE_THINK_TIME_MS=150
