# notification-service configuration. Copy to .env (the setup script does this).
SERVICE_NAME=notification-service
HOST=0.0.0.0
PORT=8004
DATABASE_URL=postgresql+psycopg://notification_svc:notification_dev_pw@localhost:5444/notification_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO

# Simulated SMS / e-mail provider
PROVIDER_FAILURE_RATE=0.0
PROVIDER_LATENCY_MS=30

# Duplicate deliveries of one event: claim lease, and how long a duplicate waits for the first
CLAIM_LEASE_SECONDS=30
DUPLICATE_WAIT_SECONDS=2.0

# Dev only: PUT /api/v1/admin/provider to change the failure rate at runtime
ADMIN_API_ENABLED=true
